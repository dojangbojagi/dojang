NEXT_PUBLIC_APP_NAME="Private Verifiable State"
NEXT_PUBLIC_APP_DESCRIPTION="Prove eligibility without revealing private state."
NEXT_PUBLIC_APP_TAGLINE="Prove more. Reveal less."

# Optional deployment-terminal presentation. These values never select a signer key.
DEPLOY_BRAND_NAME=
DEPLOY_ASCII_THEME=lime
# Optional read-only RPC override; falls back to GIWA_RPC_URL, then the public app RPC.
DEPLOY_RPC_URL=
# Public signer address for balance/readiness display; falls back to GIWA_ADMIN_ADDRESS.
DEPLOY_SIGNER_ADDRESS=

# Public network configuration. GIWA Sepolia is chain 91342; its public RPC is rate limited.
NEXT_PUBLIC_GIWA_RPC_URL=https://sepolia-rpc.giwa.io
GIWA_RPC_URL=https://sepolia-rpc.giwa.io

# Optional. Without this, the connector exposes injected wallets only.
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# Deployment inputs: public addresses and values only. The admin must match the signer
# supplied separately through a protected Foundry keystore or hardware wallet; never put a key here.
GIWA_ADMIN_ADDRESS=
GIWA_ISSUER_ADDRESS=
# Optional protected Foundry keystore account name; never put a private key here.
GIWA_ACCOUNT=

# Addresses generated by earlier deployment steps. Keep blank until their real receipts exist.
# Library addresses are linker references for HonkVerifier; the registry and adapter are
# required by the subsequent LendingPool deployment.
GIWA_ZK_TRANSCRIPT_LIB_ADDRESS=
GIWA_RELATIONS_LIB_ADDRESS=
GIWA_HONK_VERIFIER_ADDRESS=
GIWA_CREDENTIAL_REGISTRY_ADDRESS=
GIWA_VERIFIER_ADAPTER_ADDRESS=

# Governance constructor parameters (seconds / absolute voter count). These defaults satisfy
# current constructor bounds. The deployment script binds official GIWA Dojang/EAS constants.
GIWA_GOVERNANCE_VOTING_PERIOD=604800
GIWA_GOVERNANCE_QUORUM=2
GIWA_GOVERNANCE_EXECUTION_WINDOW=604800
GIWA_GOVERNANCE_INITIAL_MIN_VALIDITY=0

# Remaining project-owned deployment outputs: fill only after real broadcast receipts and readback.
# Never copy predicted addresses from a Foundry dry-run into these fields.
GIWA_RESTRICTED_VAULT_ADDRESS=
GIWA_LENDING_ASSET_ADDRESS=
GIWA_COLLATERAL_ASSET_ADDRESS=
GIWA_LENDING_POOL_ADDRESS=
GIWA_DAO_GOVERNANCE_ADDRESS=

# LendingPoolV2 outputs. Requires the registry and verifier adapter above; the V2
# deployment creates its controlled test oracle and two demo assets. The oracle
# deployment sets bounds but deliberately does not seed any prices.
GIWA_LENDING_V2_ORACLE_ADDRESS=
GIWA_LENDING_V2_ASSET_ADDRESS=
GIWA_LENDING_V2_COLLATERAL_ADDRESS=
GIWA_LENDING_V2_POOL_ADDRESS=

# Frontend addresses: set only after deployment receipts and on-chain readback.
# Source verification is a separate Blockscout status and must not be inferred from an address.
# NEXT_PUBLIC_PROOF_VERIFIER_CONTRACT is the EligibilityVerifierAdapter address.
NEXT_PUBLIC_DEMO_CREDENTIAL_REGISTRY_CONTRACT=
NEXT_PUBLIC_PROOF_VERIFIER_CONTRACT=
NEXT_PUBLIC_RESTRICTED_VAULT_CONTRACT=
NEXT_PUBLIC_LENDING_POOL_CONTRACT=
NEXT_PUBLIC_LENDING_V2_POOL_CONTRACT=
NEXT_PUBLIC_DAO_GOVERNANCE_CONTRACT=

# Robinhood Chain Testnet is an isolated chain-46630 demo configuration.
# Official Dojang verification is not native to this network; Lending V2 uses the
# project-issued DemoCredentialRegistry and the same ZK verifier circuit.
NEXT_PUBLIC_ROBINHOOD_TESTNET_RPC_URL=https://rpc.testnet.chain.robinhood.com
RH_TESTNET_RPC_URL=https://rpc.testnet.chain.robinhood.com

# Deployment inputs: public account addresses only. Use a protected Foundry account
# or hardware wallet separately; never put private keys or secrets in this file.
RH_TESTNET_ADMIN_ADDRESS=
RH_TESTNET_ISSUER_ADDRESS=
RH_TESTNET_ACCOUNT=

# Robinhood DAO Phase 1 uses project-issued registry policy 4. This is not official
# Dojang verification. These are required stack-simulation inputs, not defaults.
RH_TESTNET_GOVERNANCE_VOTING_PERIOD=
RH_TESTNET_GOVERNANCE_QUORUM=
RH_TESTNET_GOVERNANCE_EXECUTION_WINDOW=
RH_TESTNET_GOVERNANCE_INITIAL_MIN_VALIDITY=

# Controlled test-market settings. Amounts use token base units and prices use 1e18 WAD.
# They are demo deployment inputs, not production risk recommendations. The controlled
# oracle starts without a price; this configuration sets bounds only.
RH_TESTNET_LENDING_TOKEN_MINT_CAP=
RH_TESTNET_COLLATERAL_TOKEN_MINT_CAP=
RH_TESTNET_LENDING_SUPPLY_CAP=
RH_TESTNET_LENDING_BORROW_CAP=
RH_TESTNET_COLLATERAL_CAP=
RH_TESTNET_MIN_BORROW_AMOUNT=
RH_TESTNET_MAX_ORACLE_AGE=
RH_TESTNET_MAX_LTV_BPS=
RH_TESTNET_LIQUIDATION_THRESHOLD_BPS=
RH_TESTNET_LIQUIDATION_BONUS_BPS=
RH_TESTNET_CLOSE_FACTOR_BPS=
RH_TESTNET_RESERVE_FACTOR_BPS=
RH_TESTNET_OPTIMAL_UTILIZATION_BPS=
RH_TESTNET_BASE_BORROW_RATE_BPS=
RH_TESTNET_SLOPE1_BPS=
RH_TESTNET_SLOPE2_BPS=
RH_TESTNET_LENDING_PRICE_MIN_WAD=
RH_TESTNET_LENDING_PRICE_MAX_WAD=
RH_TESTNET_COLLATERAL_PRICE_MIN_WAD=
RH_TESTNET_COLLATERAL_PRICE_MAX_WAD=

# Separate-step verifier outputs, populated only after actual confirmed receipts.
# The full robinhood:stack:simulate path deploys these dependencies in one simulation.
RH_TESTNET_ZK_TRANSCRIPT_LIB_ADDRESS=
RH_TESTNET_RELATIONS_LIB_ADDRESS=
RH_TESTNET_HONK_VERIFIER_ADDRESS=

# Outputs: populate only from successful Robinhood Testnet receipts and readback.
# Never reuse GIWA addresses or addresses predicted by a no-broadcast simulation.
RH_TESTNET_CREDENTIAL_REGISTRY_ADDRESS=
RH_TESTNET_VERIFIER_ADAPTER_ADDRESS=
RH_TESTNET_LENDING_V2_ORACLE_ADDRESS=
RH_TESTNET_LENDING_V2_ASSET_ADDRESS=
RH_TESTNET_LENDING_V2_COLLATERAL_ADDRESS=
RH_TESTNET_LENDING_V2_POOL_ADDRESS=
RH_TESTNET_GOVERNANCE_ADDRESS=

# DAO Phase 2 is a separate Testnet-only deployment over the existing registry,
# verifier adapter, and Lending V2 pool. Five operational roles are intentionally
# distinct. Contracts start paused and require a separately authorized unpause.
RH_TESTNET_PHASE2_DEPLOYER_ADDRESS=
RH_TESTNET_PHASE2_ADMIN_ADDRESS=
RH_TESTNET_PHASE2_MEMBERSHIP_ISSUER_ADDRESS=
RH_TESTNET_PHASE2_REPUTATION_ISSUER_ADDRESS=
RH_TESTNET_PHASE2_PAUSE_AUTHORITY_ADDRESS=
RH_TESTNET_PHASE2_COMMIT_PERIOD=
RH_TESTNET_PHASE2_REVEAL_PERIOD=
RH_TESTNET_PHASE2_EXECUTION_WINDOW=
RH_TESTNET_PHASE2_QUORUM=
RH_TESTNET_PHASE2_MINIMUM_REPUTATION=

# Phase 2 outputs: populate only from confirmed chain-46630 deployment receipts
# and dependency/role/paused-state readback. Never use simulated addresses.
RH_TESTNET_PHASE2_REPUTATION_REGISTRY_ADDRESS=
RH_TESTNET_PHASE2_GOVERNANCE_ADDRESS=
NEXT_PUBLIC_ROBINHOOD_PHASE2_REPUTATION_REGISTRY_CONTRACT=
NEXT_PUBLIC_ROBINHOOD_PHASE2_GOVERNANCE_CONTRACT=

# Frontend-readable outputs, blank until matching Robinhood receipts and bytecode are verified.
# The Contracts page checks configured addresses against Robinhood RPC and reports Blockscout
# source-verification status separately; an environment value alone is not deployment evidence.
NEXT_PUBLIC_ROBINHOOD_ZK_TRANSCRIPT_LIB_CONTRACT=
NEXT_PUBLIC_ROBINHOOD_RELATIONS_LIB_CONTRACT=
NEXT_PUBLIC_ROBINHOOD_HONK_VERIFIER_CONTRACT=
NEXT_PUBLIC_ROBINHOOD_CREDENTIAL_REGISTRY_CONTRACT=
NEXT_PUBLIC_ROBINHOOD_VERIFIER_ADAPTER_CONTRACT=
NEXT_PUBLIC_ROBINHOOD_LENDING_V2_ORACLE_CONTRACT=
NEXT_PUBLIC_ROBINHOOD_LENDING_V2_ASSET_CONTRACT=
NEXT_PUBLIC_ROBINHOOD_LENDING_V2_COLLATERAL_CONTRACT=
NEXT_PUBLIC_ROBINHOOD_LENDING_V2_POOL_CONTRACT=
NEXT_PUBLIC_ROBINHOOD_GOVERNANCE_CONTRACT=

# Robinhood Chain Mainnet controlled demo ONLY. Mainnet is explicitly selectable,
# while Testnet remains the default interactive network. Mainnet Lending stays paused
# until authorized operators prepare a controlled demo. No production Lending, real
# asset, redeemable token, official Dojang, or production oracle claim.
NEXT_PUBLIC_ROBINHOOD_MAINNET_RPC_URL=https://rpc.mainnet.chain.robinhood.com
RH_MAINNET_RPC_URL=https://rpc.mainnet.chain.robinhood.com

# Required public role addresses before any Mainnet demo deployment. All nine addresses
# must be distinct. Match the deployment address to this protected Foundry account alias;
# the alias is not a key. Never put private keys, seed phrases, keystore files, or passwords here.
RH_MAINNET_ACCOUNT=
RH_MAINNET_DEPLOYER_ADDRESS=
RH_MAINNET_ADMIN_ADDRESS=
RH_MAINNET_ISSUER_ADDRESS=
RH_MAINNET_ORACLE_UPDATER_ADDRESS=
RH_MAINNET_RISK_ADMIN_ADDRESS=
RH_MAINNET_PAUSE_AUTHORITY_ADDRESS=
RH_MAINNET_DEMO_MINTER_ADDRESS=
RH_MAINNET_DEMO_PARTICIPANT_A_ADDRESS=
RH_MAINNET_DEMO_PARTICIPANT_B_ADDRESS=

# Mainnet demo constructor values require explicit owner/PM review. Amounts are token
# base units; prices are synthetic demo bounds in WAD, not market data. The oracle starts
# without prices. The Lending pool and DAO start paused. No defaults are intentionally set.
RH_MAINNET_DEMO_GOVERNANCE_VOTING_PERIOD=
RH_MAINNET_DEMO_GOVERNANCE_QUORUM=
RH_MAINNET_DEMO_GOVERNANCE_EXECUTION_WINDOW=
RH_MAINNET_DEMO_GOVERNANCE_INITIAL_MIN_VALIDITY=
RH_MAINNET_DEMO_LOAN_MINT_CAP=
RH_MAINNET_DEMO_COLLATERAL_MINT_CAP=
RH_MAINNET_DEMO_LENDING_SUPPLY_CAP=
RH_MAINNET_DEMO_LENDING_BORROW_CAP=
RH_MAINNET_DEMO_COLLATERAL_CAP=
RH_MAINNET_DEMO_MIN_BORROW_AMOUNT=
RH_MAINNET_DEMO_MAX_ORACLE_AGE=
RH_MAINNET_DEMO_MAX_LTV_BPS=
RH_MAINNET_DEMO_LIQUIDATION_THRESHOLD_BPS=
RH_MAINNET_DEMO_LIQUIDATION_BONUS_BPS=
RH_MAINNET_DEMO_CLOSE_FACTOR_BPS=
RH_MAINNET_DEMO_RESERVE_FACTOR_BPS=
RH_MAINNET_DEMO_OPTIMAL_UTILIZATION_BPS=
RH_MAINNET_DEMO_BASE_BORROW_RATE_BPS=
RH_MAINNET_DEMO_SLOPE1_BPS=
RH_MAINNET_DEMO_SLOPE2_BPS=
RH_MAINNET_DEMO_LOAN_PRICE_MIN_WAD=
RH_MAINNET_DEMO_LOAN_PRICE_MAX_WAD=
RH_MAINNET_DEMO_COLLATERAL_PRICE_MIN_WAD=
RH_MAINNET_DEMO_COLLATERAL_PRICE_MAX_WAD=

# Required only by the guarded Mainnet demo token-mint operator. Set each value to an
# owner-approved per-recipient/per-command cap in token base units; blank blocks mint
# simulations. This does not replace each token's immutable total supply cap.
RH_MAINNET_DEMO_SINGLE_MINT_LIMIT_LOAN=
RH_MAINNET_DEMO_SINGLE_MINT_LIMIT_COLLATERAL=

# Mainnet deployment outputs: fill only from successful chain-4663 receipts and readback.
# Never copy the predicted addresses printed by Forge simulation.
RH_MAINNET_ZK_TRANSCRIPT_LIB_ADDRESS=
RH_MAINNET_RELATIONS_LIB_ADDRESS=
RH_MAINNET_HONK_VERIFIER_ADDRESS=
RH_MAINNET_CREDENTIAL_REGISTRY_ADDRESS=
RH_MAINNET_VERIFIER_ADAPTER_ADDRESS=
RH_MAINNET_DEMO_ORACLE_ADDRESS=
RH_MAINNET_DEMO_LOAN_TOKEN_ADDRESS=
RH_MAINNET_DEMO_COLLATERAL_TOKEN_ADDRESS=
RH_MAINNET_DEMO_LENDING_POOL_ADDRESS=
RH_MAINNET_DEMO_GOVERNANCE_ADDRESS=

# Optional dormant UI registry, populated only after approved deployment and verification.
# These values are not read by active Testnet hooks and do not activate Mainnet UX.
NEXT_PUBLIC_ROBINHOOD_MAINNET_ZK_TRANSCRIPT_LIB_CONTRACT=
NEXT_PUBLIC_ROBINHOOD_MAINNET_RELATIONS_LIB_CONTRACT=
NEXT_PUBLIC_ROBINHOOD_MAINNET_HONK_VERIFIER_CONTRACT=
NEXT_PUBLIC_ROBINHOOD_MAINNET_CREDENTIAL_REGISTRY_CONTRACT=
NEXT_PUBLIC_ROBINHOOD_MAINNET_VERIFIER_ADAPTER_CONTRACT=
NEXT_PUBLIC_ROBINHOOD_MAINNET_DEMO_ORACLE_CONTRACT=
NEXT_PUBLIC_ROBINHOOD_MAINNET_DEMO_LOAN_TOKEN_CONTRACT=
NEXT_PUBLIC_ROBINHOOD_MAINNET_DEMO_COLLATERAL_TOKEN_CONTRACT=
NEXT_PUBLIC_ROBINHOOD_MAINNET_DEMO_LENDING_POOL_CONTRACT=
NEXT_PUBLIC_ROBINHOOD_MAINNET_DEMO_GOVERNANCE_CONTRACT=
# Mainnet DAO Phase 2 outputs are separate from Testnet. Populate them from
# confirmed Mainnet deployment receipts; their presence does not unpause contracts.
NEXT_PUBLIC_ROBINHOOD_MAINNET_PHASE2_REPUTATION_REGISTRY_CONTRACT=
NEXT_PUBLIC_ROBINHOOD_MAINNET_PHASE2_GOVERNANCE_CONTRACT=

# Mainnet DAO Phase 2 simulation parameters. Existing distinct role addresses are
# assigned as deployer, admin, credential issuer, risk admin/reputation issuer, and
# pause authority; the Foundry script validates separation and dependency roles.
RH_MAINNET_PHASE2_COMMIT_PERIOD=
RH_MAINNET_PHASE2_REVEAL_PERIOD=
RH_MAINNET_PHASE2_EXECUTION_WINDOW=
RH_MAINNET_PHASE2_QUORUM=
RH_MAINNET_PHASE2_MINIMUM_REPUTATION=
RH_MAINNET_PHASE2_REPUTATION_REGISTRY_ADDRESS=
RH_MAINNET_PHASE2_GOVERNANCE_ADDRESS=
