{
  "name": "giwa-private-verifiable-state",
  "version": "0.1.0",
  "private": true,
  "packageManager": "bun@1.3.14",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "contracts:test": "bash contracts/run-forge.sh test",
    "contracts:build": "bash contracts/run-forge.sh build",
    "lending:proof-fixture": "bun circuits/scripts/lending-conformance.mjs",
    "lending:anvil": "bun circuits/scripts/lending-anvil.mjs",
    "lending:v2:anvil": "bun run contracts:build && bun circuits/scripts/lending-v2-anvil.mjs",
    "lending:v2:robinhood:anvil": "bun run contracts:build && LENDING_V2_TEST_CHAIN_ID=46630 bun circuits/scripts/lending-v2-anvil.mjs",
    "robinhood:protocol:anvil": "bun run contracts:build && LENDING_V2_TEST_CHAIN_ID=46630 bun circuits/scripts/lending-v2-anvil.mjs",
    "test:lending-v2-adapters": "bun test tests/lending-v2-adapters.test.mjs",
    "governance:anvil": "bun run contracts:build && bun scripts/governance-anvil.mjs",
    "deployment:gas-local": "bun scripts/estimate-giwa-sepolia-deployment-gas.mjs",
    "deployment:simulate": "bash scripts/forge-simulate.sh",
    "robinhood:testnet:simulate": "bash scripts/forge-simulate.sh script/DeployLendingV2RobinhoodTestnet.s.sol:DeployLendingV2RobinhoodTestnet --profile robinhood_testnet --rpc-url \"$RH_TESTNET_RPC_URL\"",
    "robinhood:verifier:simulate": "bun run contracts:build && bash scripts/forge-simulate.sh script/DeployRobinhoodVerifier.s.sol:DeployRobinhoodVerifier --profile robinhood_testnet --rpc-url \"$RH_TESTNET_RPC_URL\"",
    "robinhood:stack:simulate": "bun run contracts:build && bash scripts/forge-simulate.sh script/DeployRobinhoodProtocolStack.s.sol:DeployRobinhoodProtocolStack --profile robinhood_testnet --rpc-url \"$RH_TESTNET_RPC_URL\"",
    "robinhood:dao2:simulate": "bun run contracts:build && bash scripts/forge-simulate.sh script/DeployRobinhoodDaoPhase2.s.sol:DeployRobinhoodDaoPhase2 --profile robinhood_testnet --rpc-url \"$RH_TESTNET_RPC_URL\"",
    "robinhood:dao2:l2fix:simulate": "bun scripts/robinhood-dao2-l2fix-deploy.mjs --simulate",
    "robinhood:dao2:l2fix:deploy": "bun scripts/robinhood-dao2-l2fix-deploy.mjs",
    "robinhood:dao2": "bun scripts/robinhood-dao-phase2.mjs",
    "robinhood:dao2:deploy:show": "bun scripts/robinhood-dao2-deploy-show.mjs",
    "robinhood:dao2:l2fix:show": "bun scripts/robinhood-dao2-deploy-show.mjs --artifact contracts/broadcast/DeployRobinhoodDaoPhase2L2BlockFix.s.sol/46630/run-latest.json",
    "robinhood:dao2:proof": "bun circuits/scripts/dao-phase2-conformance.mjs",
    "robinhood:mainnet:demo:build": "forge build --root contracts --profile robinhood_mainnet --use \"$PWD/contracts/solc-wrapper.sh\"",
    "robinhood:mainnet:demo:validate-config": "bun scripts/validate-robinhood-mainnet-demo-config.mjs",
    "robinhood:mainnet:demo:simulate": "bun run robinhood:mainnet:demo:build && bash scripts/forge-simulate.sh script/DeployRobinhoodMainnetDemoStack.s.sol:DeployRobinhoodMainnetDemoStack --profile robinhood_mainnet --chain-id 4663 --rpc-timeout 20 --rpc-url \"$RH_MAINNET_RPC_URL\"",
    "robinhood:mainnet:demo:proof-test": "bun run robinhood:mainnet:demo:build && LENDING_V2_TEST_CHAIN_ID=4663 bun circuits/scripts/lending-v2-mainnet-demo-anvil.mjs",
    "robinhood:mainnet:dao2:build": "forge build --root contracts --profile robinhood_mainnet --use \"$PWD/contracts/solc-wrapper.sh\"",
    "robinhood:mainnet:dao2:simulate": "bun run robinhood:mainnet:dao2:build && bash scripts/forge-simulate.sh script/DeployRobinhoodMainnetDaoPhase2.s.sol:DeployRobinhoodMainnetDaoPhase2 --profile robinhood_mainnet --chain-id 4663 --rpc-timeout 20 --rpc-url \"$RH_MAINNET_RPC_URL\"",
    "robinhood:mainnet:dao2:status": "bun scripts/robinhood-mainnet-dao2-status.mjs",
    "robinhood:mainnet:dao2:deploy": "bun scripts/robinhood-mainnet-dao2-deploy.mjs",
    "robinhood:mainnet:dao2:operator": "bun scripts/robinhood-mainnet-dao2-operator.mjs",
    "robinhood:mainnet:demo:check": "bun scripts/robinhood-mainnet-demo-postdeploy.mjs",
    "robinhood:mainnet:demo:replay": "bun scripts/robinhood-mainnet-demo-postdeploy.mjs --replay",
    "robinhood:mainnet:lending:operator": "bun scripts/robinhood-mainnet-lending-operator.mjs",
    "robinhood:mainnet:lending:user": "bun scripts/robinhood-mainnet-lending-user.mjs",
    "robinhood:mainnet:deploy": "bun scripts/robinhood-mainnet-deploy-show.mjs",
    "robinhood:mainnet:deploy:show": "bun scripts/robinhood-mainnet-deploy-show.mjs",
    "robinhood:deploy:show": "bun scripts/robinhood-deploy-show.mjs",
    "robinhood:bootstrap": "bun scripts/robinhood-bootstrap.mjs",
    "robinhood:lending": "bun scripts/robinhood-lending-operator.mjs",
    "robinhood:source:plan": "bun scripts/robinhood-source-verify-plan.mjs",
    "deploy:status": "bun scripts/deploy-console.ts status",
    "deploy:replay": "bun scripts/deploy-console.ts replay",
    "deploy:ascii": "bun scripts/deploy-console.ts ascii",
    "deploy:simulate": "bun scripts/deploy-console.ts simulate",
    "dojang:check": "bun scripts/check-dojang-rpc.ts",
    "zk:compile": "bun circuits/scripts/compile.mjs",
    "zk:conformance": "bun circuits/scripts/conformance.mjs",
    "test:browser": "bun run contracts:build && playwright test",
    "video:sync": "node remotion/scripts/sync-assets.mjs",
    "video:audio": "python3 remotion/scripts/synth-audio.py",
    "video:studio": "remotion studio remotion/index.ts",
    "video:render:protocol": "remotion render remotion/index.ts GyevoProtocol out/videos/gyevo-protocol.mp4 --concurrency=2",
    "video:render:governance": "remotion render remotion/index.ts GyevoGovernance out/videos/gyevo-trust-governance.mp4 --concurrency=2",
    "video:render:lending": "remotion render remotion/index.ts GyevoLending out/videos/gyevo-private-lending.mp4 --concurrency=2",
    "video:render": "bun run video:render:protocol && bun run video:render:governance && bun run video:render:lending && bun run video:covers",
    "video:covers": "remotion still remotion/index.ts GyevoProtocol out/videos/gyevo-protocol-cover.jpg --frame=410 && remotion still remotion/index.ts GyevoGovernance out/videos/gyevo-trust-governance-cover.jpg --frame=510 && remotion still remotion/index.ts GyevoLending out/videos/gyevo-private-lending-cover.jpg --frame=360"
  },
  "dependencies": {
    "@aztec/bb.js": "^5.2.1",
    "@noir-lang/noir_js": "1.0.0-rc.2",
    "@noir-lang/noir_wasm": "1.0.0-rc.2",
    "@openzeppelin/contracts": "^5.4.0",
    "@radix-ui/react-select": "^2.4.1",
    "@rainbow-me/rainbowkit": "^2.2.8",
    "@tanstack/react-query": "^5.90.2",
    "@x402/core": "^2.28.0",
    "@x402/evm": "^2.28.0",
    "@x402/svm": "^2.28.0",
    "lenis": "1.3.26",
    "next": "^16.0.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "viem": "^2.38.0",
    "wagmi": "^2.19.5",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@remotion/cli": "^4.0.535",
    "@types/node": "^22.18.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "remotion": "^4.0.535",
    "solc": "0.8.28",
    "typescript": "^5.9.3"
  }
}
